# Copy to .env and fill in. NEVER commit the real .env file.
NODE_ENV=development
PORT=4000
# Local: postgresql://postgres:postgres@localhost:5432/plp?schema=public
# Neon/Supabase/Render: paste the connection string from the dashboard
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plp?schema=public
# Comma separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Public base URL of THIS api (used to build absolute image URLs)
PUBLIC_API_URL=http://localhost:4000
